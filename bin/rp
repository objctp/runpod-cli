#!/usr/bin/env bash
# RunPod CLI (rp) entry point. Loads .env, sources lib/, dispatches <resource> to commands/<resource>.sh (see _help).
# Usage: rp <resource> <verb> [flags]
set -euo pipefail
# Resolve symlinks before locating the root, so rp works whether run from the
# repo, via `make install`'s link, or via the installer's
# /usr/local/bin/rp -> ~/.rp/bin/rp link. BASH_SOURCE is the invocation path
# (not the link target), so without this RP_ROOT would land in /usr/local and
# lib/ sourcing would fail. readlink is followed in a loop so relative and
# chained links both resolve; portable across macOS (BSD) and Linux (GNU).
_rp_src="${BASH_SOURCE[0]}"
while [[ -L "${_rp_src}" ]]; do
  _rp_dir="${_rp_src%/*}"
  _rp_src="$(readlink "${_rp_src}")"
  [[ "${_rp_src}" != /* ]] && _rp_src="${_rp_dir}/${_rp_src}"
done
RP_ROOT="$(cd "${_rp_src%/*}/.." && pwd)"
export RP_ROOT
unset _rp_src _rp_dir

. "$RP_ROOT/lib/common.sh"
# Hard runtime preflight (Bash 5+ / jq / curl) must run *before* the lib loop
# below: lib/args.sh and friends use Bash 5 syntax (`declare -g`), so a too-old
# Bash must be caught here with a clear message rather than a syntax error.
rp::check_runtime
# EXIT/HUP/TERM clean up temp files and continue; INT (Ctrl-C) exits quietly as
# 130 ("interrupted") — without it a SIGINT inside curl would otherwise surface
# as a bogus "curl transport error" from the emit helpers. The EXIT trap still
# runs to remove temp files on the way out.
trap _tmp_cleanup EXIT HUP TERM
trap 'exit 130' INT

# Load $RP_ROOT/.env, but never source a group/world-writable file (an attacker
# who can write it could inject RUNPOD_API_KEY or startup code), and never let a
# .env entry override a variable already exported to the environment (so an
# explicit RUNPOD_API_KEY / RUNPOD_API_KEY_FILE on the command line wins).
_rp_env_load() {
  local f="$1" perm _ln _k _rp_xtrace
  # Silence xtrace across the load: the loop reads RUNPOD_API_KEY and exports it,
  # so a `bash -x rp` trace would otherwise print the live token.
  _rp_xtrace="$(rp::_xtrace_save)"
  set +x
  # Refuse group/world-writable .env (mode has any of the group/other write
  # bits set). A writable .env is a clear compromise risk. (Fix #4)
  if stat -f '/dev/null' >/dev/null 2>&1; then
    perm="$(stat -f '%Lp' "$f")"
  else
    perm="$(stat -c '%a' "$f")"
  fi
  if [[ "$perm" =~ ^[0-7]+$ ]] && ((8#$perm & 022)); then
    rp::die "$f is group/world-writable (mode $perm); refusing to load it — run 'chmod go-w $f'"
  fi
  # Keep the readability warning for the private-but-leaked case (mode allows
  # others to read, but not write). (Fix #4 — warn, not die, here.)
  _warn_if_world_readable "$f"
  # Load only variables NOT already set in the environment, so an exported value
  # wins over a stale .env entry. (Fix #5)
  while IFS= read -r _ln || [[ -n "$_ln" ]]; do
    [[ -z "$_ln" || "$_ln" == \#* || "$_ln" =~ ^[[:space:]]*$ ]] && continue
    [[ "$_ln" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] || continue
    _k="${_ln%%=*}"
    _v="${_ln#*=}"
    # Strip a single layer of surrounding single/double quotes: `export "$_ln"`
    # keeps literal quotes inside the value, so RUNPOD_API_KEY="…" would send a
    # Bearer token wrapped in quotes and the API answers HTTP 401. (Fix #N)
    case "$_v" in
    \"*\")
      _v="${_v#\"}"
      _v="${_v%\"}"
      ;;
    \'*\')
      _v="${_v#\'}"
      _v="${_v%\'}"
      ;;
    esac
    [[ -n "${!_k:-}" ]] && continue
    # shellcheck disable=SC2163 # dynamic var name parsed from a trusted .env line
    export "$_k=$_v"
  done <"$f"
  rp::_xtrace_restore "$_rp_xtrace"
}

[[ -f "$RP_ROOT/.env" ]] && _rp_env_load "$RP_ROOT/.env"

for _RP_LIB_FILE in "$RP_ROOT"/lib/*.sh; do
  case "$_RP_LIB_FILE" in
  */common.sh) ;;
  *) . "$_RP_LIB_FILE" ;;
  esac
done
rp::check_core

_help() {
  # Slurp the heredoc once via a builtin `read` (no fork), then printf it.
  # `cat <<'EOF'` would fork cat on every --help / no-args call (~5 ms on macOS).
  if [[ -z "${_RP_HELP:-}" ]]; then
    read -r -d '' _RP_HELP <<'EOF' || true
RunPod CLI

Usage: rp <resource> <verb> [flags]   (no args prints this help)

Resources:
  volume     network volumes (create, sync models via S3, list compatible GPUs)
  serverless serverless endpoints (create, scale, run jobs, CRUD; --hub-id deploys from a Hub listing)
  pod        on-demand pods (create, start/stop, update, CRUD)
  template   pod/serverless templates (search by name)
  registry   container-registry auths
  cluster    multi-node clusters (create, rename, CRUD; member pods)
  catalog    public catalog templates (list)
  ssh-key    registered SSH keys over the v2 REST plane (alongside rp ssh)
  billing    pod / serverless / public-endpoint / cluster / network-volume billing
  account    balance + spend (GraphQL)
  hub        Hub marketplace search / get (GraphQL)
  ssh        pod ssh info (use ssh-key for keys; ssh key verbs deprecated)
  stock      GPU and CPU types and datacentres

Meta:
  api        raw REST / data-plane call (escape hatch over rp::api_call)
  doc        show command / library documentation (rp doc [filter])
  version / --version / -v   print the installed version
  upgrade [--version X]      update rp in place (re-runs the installer)

Examples:
  rp _ping
  rp stock dc
  rp volume create --name shared-data --size 100 --dc EU-RO-1
  rp pod create --name dev --image nvcr.io/nvidia/pytorch:23.10-py3 --gpu NVIDIA L4
  rp serverless create --template <id> --network-volume-id <nv> \
      --gpus-from-volume shared-data --workers-min 0 --workers-max 1 --idle 600
  rp serverless run <id> --input '{"prompt":"hello"}'
  rp billing all

Add --json to list/get commands for raw JSON.
Add --insecure (or -k, or RP_INSECURE_TLS=1) to skip TLS certificate verification
  when running from an environment whose CA bundle can't validate the API
  (e.g. inside a pod). Traffic stays encrypted; the server identity is not checked.
EOF
  fi
  printf '%s\n' "$_RP_HELP"
}

# rp version / --version / -v. lib/_version.sh (auto-sourced by the lib/*.sh
# loop below) holds the release version; a dev checkout ships "0.0.0-dev", so we
# fall back to `git describe` for a meaningful dev version. Returns the version
# on stdout.
rp::version() {
  if { [[ -z "${RP_VERSION:-}" || "${RP_VERSION}" == "0.0.0-dev" ]]; } &&
    git -C "${RP_ROOT}" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git -C "${RP_ROOT}" describe --tags --always 2>/dev/null || printf '%s\n' "${RP_VERSION:-dev}"
    return
  fi
  printf '%s\n' "${RP_VERSION:-dev}"
}

rp::main() {
  local resource="${1:-}"
  case "$resource" in
  "" | -h | --help | help)
    _help
    return 0
    ;;
  -v | --version | version)
    rp::version
    return 0
    ;;
  _ping)
    # Cheapest authenticated GET: the descriptor supplies the path, but we skip
    # rp::resource_list because unwrapping and rendering a table only to discard
    # it proves nothing beyond what the HTTP status already did.
    _resource_meta pod
    rp::http GET "$RP_RES_PATH" >/dev/null
    rp::ok "ok: REST auth works ($RP_REST_BASE)"
    return 0
    ;;
  esac
  shift
  # Reject anything that isn't a plain command-module name before we build a path
  # from it — a crafted `$resource` (e.g. `../../tmp/x`) would otherwise be
  # sourced as code. The allowlist also rejects absolute paths and glob chars.
  [[ "$resource" =~ ^[A-Za-z0-9_-]+$ ]] ||
    rp::usage "usage: unknown resource: '$resource' (try: rp --help)"
  local cmd="$RP_ROOT/commands/$resource.sh"
  [[ -f "$cmd" ]] || rp::usage "unknown resource: '$resource' (try: rp --help)"
  . "$cmd"
  declare -F "rp::cmd_$resource" >/dev/null || rp::die "command module '$resource' missing rp::cmd_$resource"
  "rp::cmd_$resource" "$@"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  rp::main "$@"
fi

# Source AFTER compinit (e.g. from ~/.zshrc):  source /path/to/completions/_rp
# The grammar is embedded, so TAB time never forks rp for the static surface;
# live values (ids, cost centers) call `rp _complete` (cached, TTL 5 min).

_rp_rows() {
  awk -F'\t' -v r="$1" -v v="$2" \
    '$1 == "f" && ($2 == r || $2 == "*") && ($3 == v || $3 == "*") && !seen[$4]++ {print $4 "\t" $5 "\t" $6}' \
    <<<"$_rp_grammar"
}

_rp_resources() {
  awk -F'\t' '$1 == "v" {print $2}' <<<"$_rp_grammar" | LC_ALL=C sort -u
}

_rp_verbs() {
  awk -F'\t' -v r="$1" '$1 == "v" && $2 == r && $3 !~ / / {print $3}' <<<"$_rp_grammar"
}

_rp_subs() {
  awk -F'\t' -v r="$1" -v g="$2" \
    '$1 == "v" && $2 == r && index($3, g" ") == 1 {sub("^"g" ", "", $3); print $3}' \
    <<<"$_rp_grammar"
}

_rp_meta() {
  _rp_rows "$1" "$2" | awk -F'\t' -v f="$3" '$1 == f {print $2 "\t" $3; exit}'
}

_rp_usage_token() {
  awk -F'\t' -v r="$1" -v v="$2" \
    '$1 == "u" && $2 == r && $3 == v {if (match($4, /<[^>]*>/)) print substr($4, RSTART, RLENGTH); exit}' \
    <<<"$_rp_grammar"
}

_rp_is_group() {
  awk -F'\t' -v r="$1" -v g="$2" \
    '$1 == "v" && $2 == r && index($3, g" ") == 1 {found = 1} END {exit !found}' \
    <<<"$_rp_grammar"
}

# Filter a newline-separated candidate list by the literal prefix $2; the
# caller owns the loop (no bash-style namerefs in zsh).
# Stripped value token of a flag ("SECURE|COMMUNITY", "path|-", "type", "").
_rp_value_token() { # $1 res, $2 fullverb, $3 flag
  local meta token
  meta="$(_rp_meta "$1" "$2" "$3")"
  token="${meta#*$'\t'}"
  token="${token#<}"
  printf '%s' "${token%>}"
}

# Stripped first-positional token of a verb's usage record ("" when none).
_rp_positional_token() { # $1 res, $2 fullverb
  local token
  token="$(_rp_usage_token "$1" "$2")"
  token="${token#<}"
  printf '%s' "${token%>}"
}

_rp() {
  local cur="${words[CURRENT]}"
  local i w res="" verb="" sub="" npos=0 skip=0 lastflag="" meta kind token
  local fullverb cand
  local -a m
  for ((i = 2; i < CURRENT; i++)); do
    w="${words[i]}"
    case "$w" in
    --)
      npos=999
      skip=0
      ;;
    -*)
      fullverb="$verb${sub:+ $sub}"
      meta=""
      [[ -n "$res" && -n "$fullverb" ]] && meta="$(_rp_meta "$res" "$fullverb" "${w#--}")"
      kind="${meta%%$'\t'*}"
      if [[ "$kind" == "value" ]]; then
        skip=1
        lastflag="${w#--}"
      else
        skip=0
      fi
      ;;
    *)
      if ((skip)); then
        skip=0
        continue
      fi
      if [[ -z "$res" ]]; then
        res="$w"
      elif [[ -z "$verb" ]]; then
        verb="$w"
      elif [[ -z "$sub" && -n "$verb" ]] && _rp_is_group "$res" "$verb"; then
        sub="$w"
      else
        npos=$((npos + 1))
      fi
      ;;
    esac
  done
  fullverb="$verb${sub:+ $sub}"

  m=()
  if ((skip)); then
    # Completing the value of $lastflag. File-shaped tokens need _files in
    # this (completion) context — a $() capture would lose its output.
    token="$(_rp_value_token "$res" "$fullverb" "$lastflag")"
    local _nl=$'\n'
    case "$token" in
    file* | path* | dir*) _files -r '/' && return 0 ;;
    *'|'*) cand="${token//|/$_nl}" ;;
    *)
      [[ "$lastflag" == "cost-center" ]] &&
        cand="$(rp _complete "$res" "$fullverb" cost-center 2>/dev/null)"
      ;;
    esac
  elif [[ "$cur" == -* ]]; then
    [[ -n "$res" && -n "$fullverb" ]] &&
      cand="$(_rp_rows "$res" "$fullverb" | awk -F'\t' '{print "--"$1}')"
  elif [[ -z "$res" ]]; then
    cand="$(_rp_resources)"
  elif [[ -z "$verb" ]]; then
    cand="$(_rp_verbs "$res")"
  elif [[ -z "$sub" && -n "$verb" ]] && _rp_is_group "$res" "$verb"; then
    cand="$(_rp_subs "$res" "$verb")"
  elif ((npos == 0)); then
    token="$(_rp_positional_token "$res" "$fullverb")"
    case "$token" in
    file* | path* | dir*) _files -r '/' && return 0 ;;
    id | endpoint | name) cand="$(rp _complete "$res" "$fullverb" - 2>/dev/null)" ;;
    esac
  fi
  local c
  while IFS= read -r c; do
    [[ -z "$c" || "$c" != "$cur"* ]] && continue
    m+=("$c")
  done <<<"${cand:-}"
  ((${#m[@]})) && compadd -- "${m[@]}"
  return 0
}


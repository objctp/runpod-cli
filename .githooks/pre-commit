#!/usr/bin/env bash
# Pre-commit: keep docs/ in sync with the `rp doc` reference blocks.
#
# docs/ is generated from the `# doc:` comments in commands/*.sh by
# scripts/gen-manual.sh (which reads `bin/rp doc`). Rather than regenerating the
# whole manual on every commit, we look at the staged files and regenerate only
# the pages whose source command actually changed — so an unrelated commit no
# longer pays for a full doc rebuild. The index is refreshed by gen-manual.sh
# itself (a single cheap `rp doc` call) whenever any command is regenerated.
# Installed via `make hooks`, which sets core.hooksPath to .githooks.
#
# Non-blocking: a tooling failure (e.g. jq or bash 5 absent in a sparse
# environment) only warns, so it can never hang or block a commit.
set -o pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$ROOT" || exit 0

[ -x bin/rp ] || exit 0
command -v bash >/dev/null 2>&1 || exit 0

# Collect command names whose source file is staged for this commit. A new,
# modified, or deleted commands/*.sh all count; lib/*.sh and other changes do
# not feed the manual, so they are ignored here.
cmds=()
while IFS= read -r f; do
  [ -n "$f" ] || continue
  case "$f" in
    commands/*.sh) cmds+=("$(basename "$f" .sh)") ;;
  esac
done < <(git diff --cached --name-only -- commands/)

[ ${#cmds[@]} -gt 0 ] || exit 0

if ./scripts/gen-manual.sh "${cmds[@]}" >/dev/null 2>&1; then
  git add docs 2>/dev/null || true
else
  echo "warning: docs generation failed; skipping docs sync" >&2
fi

# The completion artefacts embed the grammar (`rp _complete-spec`), whose
# sources are the command doc blocks plus lib/completion.sh and lib/doc.sh.
# Regenerate and stage whenever any of those is staged — same contract as the
# docs sync above: artefacts can never drift from the grammar.
grammar_changed=0
while IFS= read -r f; do
  case "$f" in
    commands/*.sh | lib/completion.sh | lib/doc.sh) grammar_changed=1 ;;
  esac
done < <(git diff --cached --name-only)

if [ "$grammar_changed" -eq 1 ]; then
  if ./scripts/gen-completion.sh >/dev/null 2>&1; then
    git add completions 2>/dev/null || true
  else
    echo "warning: completion generation failed; skipping completions sync" >&2
  fi
fi
